# When this file exists, EAS Build uses it (instead of .gitignore) to decide

# which files to upload. Mirror .gitignore here, but DO NOT list

# google-services.json so it gets uploaded to the build while staying out of git.

# dependencies

node_modules/

# standalone push notification server (not part of the app build)

push-backend/

# Expo

.expo/
dist/
web-build/
expo-env.d.ts

# Native

.kotlin/
_.orig._
_.jks
_.p8
_.p12
_.key
\*.mobileprovision

# Metro

.metro-health-check\*

# debug

npm-debug._
yarn-debug._
yarn-error.\*

# macOS

.DS_Store
\*.pem

# local env files

.env\*.local

# typescript

\*.tsbuildinfo

app-example

# generated native folders

/ios
/android

!google-services.json
